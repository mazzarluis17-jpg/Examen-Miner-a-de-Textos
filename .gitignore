# Entorno
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Cerrojo local sin anotaciones (los CSV, respaldos y revisiones sí se versionan).
anotaciones/.juicios.lock

# Datos regenerables (PRD §9)
data/*.parquet
data/*.pkl
data/*.npz
kit/data/

# Pesos de modelos y cachés de Hugging Face
hf_home/
*.safetensors
*.bin
*.onnx

# Reporte intermedio de LaTeX
reporte/*.aux
reporte/*.log
reporte/*.out
reporte/*.toc

# Editor / sistema
.DS_Store
*.swp

# Cerrojo local de revisión; decisiones e historial sí se versionan.
config/.gazetteer.lock

anotaciones/.muestra.lock
anotaciones/.gold.lock
